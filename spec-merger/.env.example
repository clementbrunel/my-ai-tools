# ──────────────────────────────────────────────
# BASE DE DONNÉES
# ──────────────────────────────────────────────
DB_USER=specmerger
DB_PASS=specmerger

# ──────────────────────────────────────────────
# FRONTEND / CORS
# ──────────────────────────────────────────────
# URL du frontend — utilisée pour autoriser les appels CORS depuis le backend.
# Doit correspondre au port configuré dans frontend/vite.config.ts (server.port) pour
# un lancement "frontend seul" (npm run dev) contre un backend local — sinon les appels
# /api échouent en 403 (CORS refusé côté Spring, voir CorsConfig).
# Plusieurs origines possibles, séparées par des virgules (ex. http://localhost:5174,http://mon-hote:5174).
FRONTEND_URL=http://localhost:5174

# ──────────────────────────────────────────────
# AUTHENTIFICATION OIDC (Keycloak via oauth2-proxy)
# ──────────────────────────────────────────────
# OIDC_ENABLED=false (défaut) : aucun login, API ouverte — dev / mode mock.
# true : nginx (frontend) place oauth2-proxy devant l'app (login Keycloak, cookie de session) et
# transmet le JWT au backend, qui le valide (OIDC_ISSUER_URI, signature/issuer/expiration).
# Il faut aussi COMPOSE_PROFILES=oidc pour démarrer le conteneur oauth2-proxy.
# L'identité n'est pas encore exploitée : les données restent rattachées à l'id de session.
OIDC_ENABLED=false
#COMPOSE_PROFILES=oidc
# URL du realm, ex. https://keycloak.example.org/realms/mon-realm
OIDC_ISSUER_URI=
# Audience exigée dans le JWT (optionnel) : derrière oauth2-proxy, le client id ci-dessous.
OIDC_AUDIENCE=
# Client Keycloak *confidentiel* (Standard flow, PKCE S256) dédié à spec-merger.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# URL publique de l'app + /oauth2/callback (à déclarer en Valid redirect URI dans Keycloak).
OIDC_REDIRECT_URL=https://spec-merger.example.org/oauth2/callback
# Secret des cookies : openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=
# false uniquement pour un essai en http://localhost
OAUTH2_PROXY_COOKIE_SECURE=true
# Bouton « Se déconnecter » : URL de fin de session Keycloak où oauth2-proxy renvoie le navigateur
# après avoir effacé son cookie (sinon le SSO Keycloak reconnecte aussitôt l'utilisateur), ex.
# https://keycloak.example.org/realms/mon-realm/protocol/openid-connect/logout?client_id=<client>&post_logout_redirect_uri=https%3A%2F%2Fspec-merger.example.org%2F
OIDC_LOGOUT_REDIRECT=
# Domaine(s) autorisés pour cette redirection (hôte de Keycloak), séparés par des virgules.
OIDC_WHITELIST_DOMAINS=

# ──────────────────────────────────────────────
# MISTRAL-VIBE (API IA interne, via Spring AI)
# ──────────────────────────────────────────────
# Tant que MISTRAL_API_KEY est vide, la résolution IA des divergences
# retombe sur un message explicite à trancher manuellement.
MISTRAL_BASE_URL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
# true : n'appelle jamais mistral-vibe, renvoie le gabarit de documentation tel quel
# (placeholders non remplis) à la place d'une génération réelle — pour avancer sur le
# reste du pipeline (diff, édition/versioning, export) sans accès réseau à mistral-vibe
# (ex. hors du réseau du bureau).
MISTRAL_MOCK=false

# ──────────────────────────────────────────────
# GITLAB (accès aux sources des projets JWAY — voir issue #266)
# ──────────────────────────────────────────────
# Tant que GITLAB_URL/GITLAB_TOKEN sont vides, le mode GitLab est simplement
# indisponible : les modes upload .zip / texte collé restent utilisables.
GITLAB_URL=
GITLAB_TOKEN=
# true : n'appelle jamais GitLab, expose à la place un unique faux projet (JXML
# d'exemple bundlé dans le jar) dans /api/gitlab/projects — pour avancer sur le
# pipeline JXML sans accès à GitLab (ex. hors du réseau du bureau), même principe
# que MISTRAL_MOCK ci-dessus.
GITLAB_MOCK=false

# Groupe 1 : fichiers de traduction .properties à noms fixes (de/en/fr.properties).
# "KEY" est un identifiant arbitraire réutilisé par le frontend/l'API pour retrouver
# le bon filtre au moment de télécharger les sources d'un projet de ce groupe.
GITLAB_GROUP_1_KEY=properties
# Chemin complet du groupe/sous-groupe ("mon-groupe/mon-sous-groupe") de préférence,
# ou ID numérique si le nom n'est pas stable.
GITLAB_GROUP_1_PATH=
GITLAB_GROUP_1_TRANSLATION_PATTERNS=**/de.properties,**/en.properties,**/fr.properties
GITLAB_GROUP_1_JAVA_PATTERNS=

# Groupe 2 : fichiers de traduction .xlf.
GITLAB_GROUP_2_KEY=xlf
GITLAB_GROUP_2_PATH=
GITLAB_GROUP_2_TRANSLATION_PATTERNS=**/*.xlf
GITLAB_GROUP_2_JAVA_PATTERNS=

# ──────────────────────────────────────────────
# PGADMIN (outil dev — non exposé en production)
# ──────────────────────────────────────────────
# Interface pgAdmin disponible sur http://localhost:5050
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=changeme