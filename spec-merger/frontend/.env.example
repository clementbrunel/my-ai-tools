# Copy to .env.local (not versioned, loaded automatically by Vite) and adjust

# Comma-separated hosts allowed to reach the Vite dev server, e.g. my-host.example.org
VITE_ALLOWED_HOSTS=

# Deployment sub-path (build only), e.g. spec-merger. Empty = served at "/"
VITE_BASE=

# OIDC (Keycloak) — leave empty to disable authentication (local dev / mock mode).
# Realm URL, e.g. https://keycloak.example.org/realms/my-realm
VITE_OIDC_AUTHORITY=
# Public client (Standard flow + PKCE) declared in that realm; its Valid redirect URIs /
# Web origins must include the app URL (backend side: OIDC_ISSUER_URI + SECURITY_ENABLED=true).
VITE_OIDC_CLIENT_ID=
