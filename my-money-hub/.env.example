# ──────────────────────────────────────────────
# BASE DE DONNÉES
# ──────────────────────────────────────────────
DB_USER=mymoneyhub
DB_PASS=mymoneyhub

# ──────────────────────────────────────────────
# ENABLE BANKING (Boursorama, N26, Revolut)
# ──────────────────────────────────────────────
# Créer une application sur le Control Panel Enable Banking, en mode "Restricted
# Production" (gratuit, comptes que tu lies toi-même — voir enablebanking.com/docs/faq).
# ENABLE_BANKING_APPLICATION_ID=
# ENABLE_BANKING_PRIVATE_KEY_PATH=/run/secrets/enable_banking_private_key.pem

# ──────────────────────────────────────────────
# WOOB (BNP Paribas)
# ──────────────────────────────────────────────
# woob doit être installé et le backend "bnp" configuré séparément :
#   pip install woob && woob config add bnp
# WOOB_BINARY_PATH=woob

# ──────────────────────────────────────────────
# PGADMIN (outil dev — non exposé en production)
# ──────────────────────────────────────────────
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=changeme
