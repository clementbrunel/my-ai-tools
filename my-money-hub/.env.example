# ──────────────────────────────────────────────
# BASE DE DONNÉES
# ──────────────────────────────────────────────
DB_USER=mymoneyhub
DB_PASS=mymoneyhub

# ──────────────────────────────────────────────
# ENABLE BANKING (Boursorama, N26, Revolut)
# ──────────────────────────────────────────────
# Créer une application sur le Control Panel Enable Banking, en mode "Restricted
# Production" (gratuit, comptes que tu lies toi-même — voir enablebanking.com/docs/faq).
# Clé privée : le .pem téléchargé à la création de l'application (format PKCS#8, sinon
#   openssl pkcs8 -topk8 -nocrypt -in key.pem -out key-pkcs8.pem).
# URL de redirection à déclarer sur l'application : ENABLE_BANKING_REDIRECT_URL ci-dessous.
# Une institution Enable Banking = externalRef "Boursorama" | "N26" | "Revolut" (nom ASPSP
# exact de GET /aspsps), externalCountry "FR" ; puis bouton "Connecter" sur le dashboard.
# ENABLE_BANKING_APPLICATION_ID=
# ENABLE_BANKING_PRIVATE_KEY_PATH=/run/secrets/enable_banking_private_key.pem
# ENABLE_BANKING_REDIRECT_URL=http://localhost:3001/api/enable-banking/callback
# ENABLE_BANKING_FRONTEND_URL=http://localhost:3001/
# ENABLE_BANKING_CONSENT_VALIDITY_DAYS=90

# ──────────────────────────────────────────────
# WOOB (BNP Paribas)
# ──────────────────────────────────────────────
# woob doit être installé et le backend "bnp" configuré séparément :
#   pip install woob && woob config add bnp
# WOOB_BINARY_PATH=woob

# ──────────────────────────────────────────────
# PGADMIN (outil dev — non exposé en production)
# ──────────────────────────────────────────────
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=changeme
