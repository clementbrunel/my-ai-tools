# ──────────────────────────────────────────────
# BASE DE DONNÉES
# ──────────────────────────────────────────────
# En dev, "pronocore" suffit. En production, utiliser des credentials forts.
DB_USER=pronocore
DB_PASS=pronocore

# ──────────────────────────────────────────────
# SÉCURITÉ
# ──────────────────────────────────────────────
# Clé de signature JWT — OBLIGATOIRE, pas de valeur par défaut dans l'appli.
# Générer une clé forte : openssl rand -base64 64
JWT_SECRET=worldcup2026secretkey1234567890123456789012

# ──────────────────────────────────────────────
# EMAIL (Resend.com)
# ──────────────────────────────────────────────
# Créer une clé sur https://resend.com → API Keys
RESEND_API_KEY=re_your_api_key_here

# ──────────────────────────────────────────────
# API-FOOTBALL (api-football.com)
# ──────────────────────────────────────────────
# Source des scores de football en temps réel. Créer une clé sur
# https://dashboard.api-football.com → Profile → API Key.
# Laissée vide, la synchronisation automatique des scores reste désactivée
# (l'appli démarre normalement, elle log juste un avertissement au boot).
API_FOOTBALL_KEY=

# ──────────────────────────────────────────────
# FRONTEND / CORS
# ──────────────────────────────────────────────
# URL du frontend — utilisée pour CORS et les liens dans les emails
FRONTEND_URL=http://localhost:5173

# Origine CORS supplémentaire optionnelle (ex: accès réseau local depuis une TV ou NAS)
# CORS_EXTRA_ORIGIN=http://192.168.x.x:3000

# ──────────────────────────────────────────────
# PGADMIN (outil dev — non exposé en production)
# ──────────────────────────────────────────────
# Interface pgAdmin disponible sur http://localhost:5050
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=changeme

# ──────────────────────────────────────────────
# PRODUCTION UNIQUEMENT
# ──────────────────────────────────────────────
# Adresse du registry Docker privé (utilisée par build-and-push.sh et docker-compose.prod.yml)
# REGISTRY=myregistry:5000

# ──────────────────────────────────────────────
# MAINTENANCE
# ──────────────────────────────────────────────
# Répare les checksums Flyway au démarrage (migration éditée après apply).
# Activer une seule fois, redémarrer le backend, puis retirer.
# APP_FLYWAY_REPAIR=true
