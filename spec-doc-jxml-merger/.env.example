# ──────────────────────────────────────────────
# BASE DE DONNÉES
# ──────────────────────────────────────────────
DB_USER=specmerger
DB_PASS=specmerger

# ──────────────────────────────────────────────
# FRONTEND / CORS
# ──────────────────────────────────────────────
# URL du frontend — utilisée pour autoriser les appels CORS depuis le backend
FRONTEND_URL=http://localhost:5173

# ──────────────────────────────────────────────
# MISTRAL-VIBE (API IA interne, via Spring AI)
# ──────────────────────────────────────────────
# Tant que MISTRAL_API_KEY est vide, la résolution IA des divergences
# retombe sur un message explicite à trancher manuellement.
MISTRAL_BASE_URL=
MISTRAL_API_KEY=
MISTRAL_MODEL=

# ──────────────────────────────────────────────
# GITLAB (accès aux sources des projets JWAY — voir issue #266)
# ──────────────────────────────────────────────
# Tant que GITLAB_URL/GITLAB_TOKEN sont vides, le mode GitLab est simplement
# indisponible : les modes upload .zip / texte collé restent utilisables.
GITLAB_URL=
GITLAB_TOKEN=
# Sous-groupe contenant les projets JWAY : chemin complet ("mon-groupe/mon-sous-groupe")
# de préférence, ou ID numérique si le nom n'est pas stable.
GITLAB_SUBGROUP=
# Patterns Ant (séparés par des virgules) des fichiers à inclure en plus des .jxml
# (toujours inclus). À ajuster selon la structure réelle des projets du sous-groupe.
GITLAB_TRANSLATION_PATTERNS=**/*.properties,**/trad/**,**/i18n/**
# Patterns Ant des classes Java d'appels métier vers l'extérieur à inclure.
# Vide par défaut : aucune classe Java n'est envoyée tant que ce n'est pas configuré.
GITLAB_JAVA_PATTERNS=
