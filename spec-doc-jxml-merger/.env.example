# ──────────────────────────────────────────────
# BASE DE DONNÉES
# ──────────────────────────────────────────────
DB_USER=specmerger
DB_PASS=specmerger

# ──────────────────────────────────────────────
# FRONTEND / CORS
# ──────────────────────────────────────────────
# URL du frontend — utilisée pour autoriser les appels CORS depuis le backend
FRONTEND_URL=http://localhost:5173

# ──────────────────────────────────────────────
# MISTRAL-VIBE (API IA interne, via Spring AI)
# ──────────────────────────────────────────────
# Tant que MISTRAL_API_KEY est vide, la résolution IA des divergences
# retombe sur un message explicite à trancher manuellement.
MISTRAL_BASE_URL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
