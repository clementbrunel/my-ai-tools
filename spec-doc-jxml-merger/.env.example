# ──────────────────────────────────────────────
# BASE DE DONNÉES
# ──────────────────────────────────────────────
DB_USER=specmerger
DB_PASS=specmerger

# ──────────────────────────────────────────────
# FRONTEND / CORS
# ──────────────────────────────────────────────
# URL du frontend — utilisée pour autoriser les appels CORS depuis le backend
FRONTEND_URL=http://localhost:5173

# ──────────────────────────────────────────────
# MISTRAL-VIBE (API IA interne)
# ──────────────────────────────────────────────
# À renseigner une fois la doc/clé fournie en interne. Tant que c'est vide,
# la résolution IA des divergences retombe sur un message explicite à trancher manuellement.
MISTRAL_VIBE_BASE_URL=
MISTRAL_VIBE_API_KEY=
